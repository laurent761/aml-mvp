# This file is safe only for local development. Generate new random credentials
# before setting DEPLOYMENT_ENVIRONMENT=test or production.
# The UI and HTTP API always use one shared Admin with no user login or token.
# Changing DEPLOYMENT_ENVIRONMENT does not enable user authentication.
DEPLOYMENT_ENVIRONMENT=development
LOG_LEVEL=INFO
BIND_ADDRESS=127.0.0.1

API_PORT=8000
UI_PORT=3000
# Path is resolved from backend/compose.yaml. The integrated bundle uses ../ui.
UI_BUILD_CONTEXT=../ui
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5000
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

POSTGRES_USER=adversarial
POSTGRES_PASSWORD=adversarial-local-only
POSTGRES_DB=adversarial
DATABASE_URL=postgresql+psycopg://adversarial:adversarial-local-only@postgres:5432/adversarial

MINIO_ROOT_USER=adversarial-minio
MINIO_ROOT_PASSWORD=adversarial-minio-local-only-change-me
ARTIFACT_BACKEND=s3
S3_BUCKET=adversarial-evidence
S3_REGION=us-east-1
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
MLFLOW_EXPERIMENT_NAME=adversarial-agent-mvp

CAPSULE_RUNTIME=docker
# Internal service credentials for the supervisor and target capabilities.
CAPSULE_SUPERVISOR_TOKEN=development-only-supervisor-token-change-me
CAPABILITY_SIGNING_KEY=development-only-signing-key-change-me
BLUE_GATEWAY_IMAGE=blue-gateway:local
MAX_CAPSULE_CONCURRENCY=4
DOCKER_SOCKET=/var/run/docker.sock
# Linux only: `stat -c '%g' /var/run/docker.sock`. Docker Desktop commonly uses 0.
DOCKER_GID=0

# Firecracker is an external audited runner implementing the supervisor contract.
# It is not bundled or claimed validated by this Compose profile.
FIRECRACKER_RUNNER_URL=
FIRECRACKER_RUNNER_TOKEN=

WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=1.0
WORKER_RETRY_MAX_SECONDS=30.0
MAX_WORKER_CONCURRENCY=4

ATTACKER_MODEL_PROVIDER=heuristic
# For learned workers, mount the checkpoint at the configured container path.
ATTACKER_CHECKPOINT_PATH=
ATTACKER_CHECKPOINT_SHA256=
ATTACKER_LEARNED_RANKING=true
# Also supported: hosted_openai_compatible (API key required) and
# local_openai_compatible (key optional, for a trusted local endpoint).
ATTACKER_MODEL_BASE_URL=
ATTACKER_MODEL_NAME=
ATTACKER_MODEL_API_KEY=
ATTACKER_MODEL_INPUT_COST_PER_MILLION=0
ATTACKER_MODEL_OUTPUT_COST_PER_MILLION=0

OTEL_ENABLED=true
OTEL_EXPORT_INTERVAL_SECONDS=15

# Target inference is separate from the attacker. Only the supervisor receives
# these settings. No model is selected by default. Base URL includes /v1/.
# Pricing is operator supplied; zero rates are explicitly recorded as unpriced.
TARGET_MODEL_PROVIDER=disabled
TARGET_MODEL_BASE_URL=
TARGET_MODEL_NAME=
TARGET_MODEL_API_KEY=
TARGET_MODEL_REVISION=
TARGET_MODEL_TEMPERATURE=0
TARGET_MODEL_TOP_P=1
TARGET_MODEL_MAX_OUTPUT_TOKENS=1000
TARGET_MODEL_TOKEN_PARAMETER=max_tokens
TARGET_MODEL_JSON_MODE=true
TARGET_MODEL_TIMEOUT_SECONDS=30
TARGET_MODEL_MAX_INPUT_BYTES=65536
TARGET_MODEL_MAX_RESPONSE_BYTES=262144
TARGET_MODEL_MAX_REQUESTS=100
TARGET_MODEL_MAX_TOTAL_TOKENS=200000
TARGET_MODEL_MAX_COST=10
TARGET_MODEL_INPUT_COST_PER_MILLION=0
TARGET_MODEL_OUTPUT_COST_PER_MILLION=0
TARGET_MODEL_MAX_CONCURRENCY=4

# Shared Admin resource limits. OWNER settings apply to the existing local owner
# used for research records, quotas and idempotency, not separate user accounts.
RESEARCH_MAX_SESSIONS_PER_OWNER=4
RESEARCH_OWNER_COST_LIMIT=100
RESEARCH_OWNER_STORAGE_BYTES=107374182400
RESEARCH_MAX_REQUEST_BYTES=1048576
RESEARCH_REQUESTS_PER_MINUTE=600
RESEARCH_UPLOAD_ROOT=./var/uploads
RESEARCH_UPLOAD_EXPIRY_SECONDS=86400
